#!/usr/bin/env bash
# Quick tests, run by every branch build (PC and fallback) before building: the logic tests, which
# need no video, no models and no window. Windows only.
set -euo pipefail
cd "$(dirname "$0")/../.."
[ "${OS:-}" = Windows_NT ] || { echo "IdleTrim's tests run only on Windows." >&2; exit 1; }
dotnet build tests/Tests.csproj -c Release -nologo -v q
build/bin/Tests/Release/net8.0-windows/Tests.exe
